<%- include('partials/header') %>
<section class="container" style="padding-top:56px; padding-bottom:80px;">
  <div class="eyebrow">Support</div>
  <h1>How can we help?</h1>
  <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:28px;">
    <div class="card">
      <h3 style="font-size:1rem;">Shipping & returns</h3>
      <p class="muted">Orders ship within 2 business days. Returns are accepted within 30 days, unworn and with tags.</p>
    </div>
    <div class="card">
      <h3 style="font-size:1rem;">Sizing guide</h3>
      <p class="muted">Footwear runs true to size. Packs are sized by torso length — see each product page for a fit chart.</p>
    </div>
    <div class="card">
      <h3 style="font-size:1rem;">Still stuck?</h3>
      <p class="muted">Send us a note and a real person will get back to you.</p>
      <a class="btn btn-small" href="/support/new">Contact support</a>
      <a class="btn btn-small btn-outline" style="margin-left:8px;" href="/support/chat">Live chat</a>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
