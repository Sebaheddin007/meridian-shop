<%- include('partials/header') %>
<section class="form-page container-narrow">
  <div class="card">
    <h1>Reset your password</h1>

    <% if (notice) { %><div class="alert alert-info"><%= notice %></div><% } %>
    <% if (typeof resetLink !== 'undefined' && resetLink) { %>
      <div class="alert alert-info" style="word-break:break-all;">
        (Demo mode — this is normally emailed) Reset link: <a href="<%= resetLink %>"><%= resetLink %></a>
      </div>
    <% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (!showCodeForm) { %>
      <form action="/forgot-password" method="POST">
        <div class="field">
          <label>Email address</label>
          <input type="email" name="email" required>
        </div>
        <button type="submit" style="width:100%;">Send reset code</button>
      </form>
    <% } else { %>
      <form action="/reset-password" method="POST">
        <input type="hidden" name="email" value="<%= email %>">
        <div class="field">
          <label>4-digit code</label>
          <input type="text" name="code" maxlength="4" value="<%= typeof prefillCode !== 'undefined' ? prefillCode : '' %>" required>
        </div>
        <div class="field">
          <label>New password</label>
          <input type="password" name="new_password" required>
        </div>
        <button type="submit" style="width:100%;">Reset password</button>
      </form>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
