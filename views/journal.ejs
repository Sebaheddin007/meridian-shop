<%- include('partials/header') %>
<section class="container" style="padding-top:56px;">
  <div class="eyebrow">Journal</div>
  <h1 style="margin-bottom:28px;">Notes from the field</h1>
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:28px;">
    <div class="card">
      <div class="cat" style="text-transform:uppercase; font-size:.75rem; color:var(--ink-soft);">Gear care</div>
      <h3>Re-waxing a canvas pack for the wet season</h3>
      <p class="muted">A short walkthrough on stripping old wax, reheating the canvas, and building an even coat before the rain sets in.</p>
    </div>
    <div class="card">
      <div class="cat" style="text-transform:uppercase; font-size:.75rem; color:var(--ink-soft);">Trip report</div>
      <h3>Five days on the Wallowa traverse</h3>
      <p class="muted">Notes on water sources, a late-season snow crossing, and why we ended up glad we packed the synthetic bag.</p>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
