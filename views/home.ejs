<%- include('partials/header') %>

<section
  class="hero"
  style="
    padding-bottom:0;
    background:
      linear-gradient(rgba(15, 25, 20, 0.48), rgba(15, 25, 20, 0.68)),
      url('/images/hero-background.jpg');
    background-size:cover;
    background-position:center;
    background-repeat:no-repeat;
  "
>
  <div class="hero-inner">
    <div style="color:#fff;">
      <div class="hero-eyebrow">Autumn restock</div>

      <h1 style="color:#fff;">
        Gear that earns a second and third trip.
      </h1>

      <p style="color:#f1f1f1;">
        We design a small, deliberate catalog of backpacks, shelter,
        and home goods — built to be repaired, not replaced.
      </p>

      <div style="margin-top:28px; display:flex; gap:14px;">
        <a class="btn btn-ochre" href="/shop">
          Shop the catalog
        </a>

        <a
          class="btn btn-outline"
          style="color:#fff; border-color:#fff;"
          href="/journal"
        >
          Read the journal
        </a>
      </div>
    </div>

    <div
      class="hero-visual"
      style="
        background-image:
          linear-gradient(rgba(0,0,0,0.15), rgba(0,0,0,0.35)),
          url('/images/outdoor-background.jpg');
        background-size:cover;
        background-position:center;
      "
    >
      <span>
        Basecamp, Wallowa Mountains — Sept 2025
      </span>
    </div>
  </div>
</section>


<section class="container">
  <div class="section-head">
    <div>
      <div class="eyebrow">Featured</div>
      <h2>New this season</h2>
    </div>

    <a href="/shop">View all products →</a>
  </div>

  <div class="product-grid">
    <% featured.forEach(p => { %>
      <a
        class="product-card"
        href="/product/<%= p.slug %>"
        style="color:inherit;"
      >
        <div class="thumb">
          <img
            src="<%= p.image %>"
            alt="<%= p.name %>"
            style="
              width:100%;
              height:100%;
              object-fit:cover;
              display:block;
            "
          >
        </div>

        <div class="body">
          <div class="cat">
            <%= p.category %>
          </div>

          <h3>
            <%= p.name %>
          </h3>

          <div class="price">
            $<%= p.price.toFixed(2) %>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
</section>


<section class="container" style="padding-top:10px;">

  <div
    style="
      min-height:320px;
      border-radius:10px;
      overflow:hidden;
      position:relative;
      display:flex;
      align-items:center;
      margin-bottom:28px;
      background:
        linear-gradient(
          90deg,
          rgba(18,30,24,0.78),
          rgba(18,30,24,0.20)
        ),
        url('/images/outdoor-background.jpg');
      background-size:cover;
      background-position:center;
    "
  >

    <div
      style="
        padding:48px;
        max-width:560px;
        color:#fff;
      "
    >

      <div
        style="
          font-size:.75rem;
          text-transform:uppercase;
          letter-spacing:.1em;
          margin-bottom:12px;
          opacity:.85;
        "
      >
        Outdoor collection
      </div>

      <h2 style="color:#fff; font-size:2rem;">
        Built for the trail.
      </h2>

      <p style="color:#f2f2f2;">
        Reliable backpacks, tents, footwear and sleeping gear
        for your next adventure.
      </p>

      <a
        class="btn btn-ochre"
        href="/shop"
        style="margin-top:12px;"
      >
        Explore outdoor gear
      </a>

    </div>
  </div>


  <div
    style="
      min-height:320px;
      border-radius:10px;
      overflow:hidden;
      position:relative;
      display:flex;
      align-items:center;
      margin-bottom:40px;
      background:
        linear-gradient(
          90deg,
          rgba(38,30,20,0.78),
          rgba(38,30,20,0.20)
        ),
        url('/images/home-kitchen-background.jpg');
      background-size:cover;
      background-position:center;
    "
  >

    <div
      style="
        padding:48px;
        max-width:560px;
        color:#fff;
      "
    >

      <div
        style="
          font-size:.75rem;
          text-transform:uppercase;
          letter-spacing:.1em;
          margin-bottom:12px;
          opacity:.85;
        "
      >
        Home & kitchen
      </div>

      <h2 style="color:#fff; font-size:2rem;">
        Comfort beyond the campsite.
      </h2>

      <p style="color:#f2f2f2;">
        Thoughtful home goods designed for slow mornings,
        warm kitchens and comfortable evenings.
      </p>

      <a
        class="btn btn-ochre"
        href="/shop?category=Home"
        style="margin-top:12px;"
      >
        Explore home goods
      </a>

    </div>
  </div>

</section>


<section class="container" style="padding-top:0;">
  <div
    class="card"
    style="
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:24px;
      flex-wrap:wrap;
    "
  >

    <div>
      <h3 style="margin-bottom:6px;">
        Need a hand with an order?
      </h3>

      <p class="muted" style="margin:0;">
        Our support team usually replies within a day.
      </p>
    </div>

    <a class="btn" href="/support/new">
      Contact support
    </a>

  </div>
</section>


<%- include('partials/footer') %>