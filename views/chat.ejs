<%- include('partials/header') %>
<section class="container" style="padding-top:48px; padding-bottom:80px; max-width:640px;">
  <div class="breadcrumb"><a href="/support">Support</a> / Live chat</div>
  <h1 style="font-size:1.6rem;">Live chat</h1>
  <p class="muted">Connected to a support agent. Messages are visible to everyone currently in this chat room.</p>

  <div class="card">
    <div id="log" style="height:280px; overflow-y:auto; border:1px solid var(--line); border-radius:4px; padding:12px; background:var(--paper); font-size:0.9rem; margin-bottom:14px;"></div>
    <form id="chat-form" style="display:flex; gap:10px;">
      <input type="text" id="msg" placeholder="Type a message…" autocomplete="off" style="flex:1;">
      <button type="submit">Send</button>
    </form>
  </div>
</section>
<%- include('partials/footer') %>

<script>
  const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
  const ws = new WebSocket(proto + '//' + location.host + '/chat');
  const log = document.getElementById('log');

  ws.addEventListener('message', (event) => {
    const div = document.createElement('div');
    div.style.marginBottom = '6px';
    // Message HTML is inserted directly — the server does not sanitize it,
    // and neither does this client.
    div.innerHTML = event.data;
    log.appendChild(div);
    log.scrollTop = log.scrollHeight;
  });

  document.getElementById('chat-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('msg');
    if (!input.value.trim()) return;
    ws.send(JSON.stringify({ name: '<%= user ? user.display_name : "Guest" %>', text: input.value }));
    input.value = '';
  });
</script>
